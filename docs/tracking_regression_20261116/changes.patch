+#!/usr/bin/env python3
+"""Real OSNet workload microbenchmark; no camera/controller or identity accuracy claim."""
+import argparse,copy,json,time
+from pathlib import Path
+import numpy as np
+import torch
+import cv2
+from identity_replay import load_cache,settings
+from ai.identity_manager import IdentityAwareTargetSelector
+from ai.reid.trusted_gallery import TrustedTargetGallery
+from ai.overlap_policy import overlap_geometry
+from person_search.reid import OSNetReID
+from telemetry import latency
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--cache',type=Path,required=True)
+    p.add_argument('--out',type=Path,required=True)
+    p.add_argument('--device',default='cuda:0')
+    p.add_argument('--frames',type=int,default=20)
+    p.add_argument('--min-candidates',type=int,default=1)
+    args=p.parse_args()
+    cv2.setNumThreads(1);torch.set_num_threads(1)
+    rows,loader,ref=load_cache(args.cache);cfg=settings()
+    model=OSNetReID(cfg.REID_MODEL_PATH,device=args.device,batch_size=cfg.REID_BATCH_SIZE)
+    s=IdentityAwareTargetSelector(cfg,model);s.embedding=ref[0].to(model.device)
+    s.gallery=TrustedTargetGallery(ref.to(model.device));s.error=None
+    records=[r for r in rows if sum(d['confidence']>=cfg.PERSON_CONF_THRESHOLD for d in r['detections'])>=args.min_candidates][:args.frames]
+    if not records:raise ValueError('No detections to benchmark')
+    # Largest high-confidence bbox is a reproducible workload anchor ONLY.
+    # This benchmark does not identify the true target or replay selector decisions.
+    results={name:[] for name in ['all_candidates','local_candidates']}
+    crops={name:[] for name in results}
+    model.extract_embeddings([loader(records[0])])  # cold model warmup excluded
+    profiler=latency.LatencyProfiler(args.out.parent/'reid_profile',enabled=True,detailed_gpu_profiling=True)
+    old=latency.profiler;latency.profiler=profiler
+    try:
+        for index,row in enumerate(records):
+            frame=loader(row)
+            people=[dict(d,track_id=i) for i,d in enumerate(row['detections']) if d['confidence']>=cfg.PERSON_CONF_THRESHOLD]
+            if not people:continue
+            anchor=max(people,key=lambda d:(d['bbox'][2]-d['bbox'][0])*(d['bbox'][3]-d['bbox'][1]))
+            local=[d for d in people if d is anchor or overlap_geometry(anchor['bbox'],d['bbox'])['overlap']>0]
+            for name in (list(results) if index%2==0 else list(reversed(results))):
+                s.cfg.IDENTITY_REID_OPTIMIZED=name=='local_candidates'
+                batch=people if name=='all_candidates' else local
+                s.frame_id=row['frame_id'];now=time.monotonic()
+                with latency.correlated(benchmark_branch=name):
+                    s._launch(frame,batch,now)
+                s._job[0].result(timeout=30)
+                results[name].append((time.monotonic()-now)*1000);crops[name].append(len(batch));s._job=None
+    finally:
+        profiler.close();latency.profiler=old
+    output=dict(scope='Real OSNet + quality/normalization + gallery + async copy/scheduling; no simultaneous YOLO/GUI. Alternating order, warm model, same cached frames. Largest-box workload anchor is NOT ground truth.',physical_ptz_commands=0,
+        branches={k:dict(samples=len(v),mean_ms=float(np.mean(v)),p95_ms=float(np.percentile(v,95)),mean_candidates=float(np.mean(crops[k]))) for k,v in results.items()})
+    args.out.write_text(json.dumps(output,indent=2));print(json.dumps(output,indent=2))
+if __name__=='__main__':main()
