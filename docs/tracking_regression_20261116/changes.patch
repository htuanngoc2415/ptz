+#!/usr/bin/env python3
+"""Labelled scripted safety scenarios, not real identity accuracy."""
+import argparse,json
+from pathlib import Path
+import cv2,numpy as np,torch
+from identity_replay import replay
+
+
+def scenario(name):
+    records=[];truth=[]; images={}
+    rng=np.random.default_rng(42)
+    background=rng.integers(0,255,(400,600,3),dtype=np.uint8)
+    for i in range(100):
+        box=[100+i*.4,60,170+i*.4,260];visible=True;score=.95;others=[]
+        if name=='rotation_dip' and 25<=i<60:score=.4
+        if name=='weak_contact' and 20<=i<70:
+            others=[dict(bbox=[box[2]-5,80,box[2]+10,100],confidence=.95,reid_score=.1)]
+        if name=='crossing' and 30<=i<50:
+            others=[dict(bbox=[box[0]+10,60,box[2]+10,260],confidence=.95,reid_score=.1)]
+        if name=='ambiguous_candidates' and 30<=i<55:
+            others=[dict(bbox=[box[0]+10,60,box[2]+10,260],confidence=.95,reid_score=.94)]
+        if name=='occlusion_reentry' and 30<=i<45:visible=False
+        if name=='boundary' and 30<=i<55:box=[0,60,70,260]
+        frame=background
+        if name=='pan_zoom':
+            scale=1+i*.001;dx=i*.8
+            H=np.array([[scale,0,dx],[0,scale,0]],np.float32)
+            frame=cv2.warpAffine(background,H,(600,400))
+            box=[box[0]*scale+dx,box[1]*scale,box[2]*scale+dx,box[3]*scale]
+        detections=([dict(bbox=box,confidence=.95,reid_score=score)] if visible else [])+others
+        records.append(dict(frame_id=i,timestamp=i*.1,detections=detections))
+        truth.append(dict(frame_id=i,target_identity='target',people=([dict(identity='target',bbox=box)] if visible else [])+[dict(identity='other',bbox=p['bbox']) for p in others]))
+        images[i]=frame
+    return replay(records,lambda r:images[r['frame_id']],torch.eye(512)[:1],truth,ablations=True)
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__);p.add_argument('--out',type=Path,required=True);args=p.parse_args()
+    cv2.setNumThreads(1);torch.set_num_threads(1)
+    result={}
+    for name in ['rotation_dip','weak_contact','crossing','ambiguous_candidates','occlusion_reentry','boundary','pan_zoom']:
+        r=scenario(name)
+        for branch in r['branches'].values():branch.pop('decisions')
+        result[name]=r
+    args.out.write_text(json.dumps(dict(provenance='Scripted boxes and appearance with synthetic identity labels; no model accuracy or live stability claims.',scenarios=result),indent=2))
+if __name__=='__main__':main()
