+    def test_two_live_views_support_anchored_recovery_not_one_lucky_match(self):
+        gallery = TrustedTargetGallery(torch.eye(512)[:1])
+        a = torch.zeros(512); a[0] = .7; a[1] = (1-.7**2)**.5
+        b = torch.zeros(512); b[0] = .7; b[1] = .65; b[2] = (1-.7**2-.65**2)**.5
+        candidate = torch.zeros(512); candidate[0] = .6; candidate[1] = .8
+        gallery = gallery.admit(a, dict(frame_id=1), reference_threshold=.65)
+        self.assertLess(gallery.score(candidate[None]).item(), .7)
+        gallery = gallery.admit(b, dict(frame_id=2), reference_threshold=.65)
+        self.assertGreater(gallery.score(candidate[None]).item(), .7)
+        candidate[0] = .4; candidate[1] = (1-.4**2)**.5
+        self.assertLess(gallery.score(candidate[None]).item(), .5)
