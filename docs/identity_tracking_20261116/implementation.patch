+    def test_reference_immutable_size_duplicates_rollback(self):
+        reference = torch.eye(512)[:1]
+        gallery = TrustedTargetGallery(reference, max_size=3)
+        for i in range(1, 5):
+            gallery = gallery.admit(self.vector(.75, i), dict(frame_id=i), reference_threshold=.65)
+        self.assertEqual(len(gallery.embeddings), 3)
+        self.assertTrue(torch.equal(gallery.embeddings[0], reference[0]))
+        self.assertIs(gallery.admit(self.vector(.75, 4), dict(frame_id=5), reference_threshold=.65), gallery)
+        self.assertEqual(len(gallery.rollback(3).embeddings), 1)
+
+    def test_one_live_match_cannot_confirm_and_anchor_cannot_drift(self):
+        gallery = TrustedTargetGallery(torch.eye(512)[:1])
+        row = self.vector(.65, 1)
+        gallery = gallery.admit(row, dict(frame_id=1), reference_threshold=.65)
+        self.assertAlmostEqual(gallery.score(row[None]).item(), .65, places=5)
+        before = gallery
+        gallery = gallery.admit(self.vector(.4, 2), dict(frame_id=2), reference_threshold=.65)
+        self.assertIs(gallery, before)
+        with self.assertRaises(ValueError):
+            gallery.admit(torch.ones(512), dict(frame_id=2), reference_threshold=.65)
