+#!/usr/bin/env python3
+"""Annotate cached replay observations with persistent person labels using OpenCV.
+
+Space/Enter accepts an ROI, C cancels it. Enter the same person label across all
+frames. Use the label 'target' for the reference person. Empty label finishes a
+frame; 'skip' leaves it unannotated. An empty people list explicitly means nobody
+is visible. This tool requires a desktop display and never connects to a camera.
+"""
+import argparse
+import json
+from pathlib import Path
+import cv2
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--cache', type=Path, required=True)
+    p.add_argument('--out', type=Path, required=True)
+    p.add_argument('--stride', type=int, default=1)
+    args = p.parse_args()
+    if args.stride < 1: p.error('stride must be positive')
+    rows = [json.loads(s) for s in (args.cache/'frames.jsonl').read_text().splitlines()]
+    done = {r['frame_id']:r for r in map(json.loads, args.out.read_text().splitlines())} if args.out.exists() else {}
+    try:
+        for row in rows[::args.stride]:
+            if row['frame_id'] in done and done[row['frame_id']].get('people') is not None: continue
+            image = cv2.imread(str(args.cache/row['image']))
+            if image is None: raise ValueError('Missing image: '+row['image'])
+            print(f"Frame {row['frame_id']}, video {row['timestamp']:.3f}s")
+            cv2.imshow('identity annotations', image)
+            cv2.waitKey(1)
+            people = []
+            while True:
+                label = input('Persistent person label (target/person_b/..., empty=done, skip, quit): ').strip()
+                if label == 'quit': return
+                if label == 'skip':
+                    people = None
+                    break
+                if not label: break
+                x,y,w,h = cv2.selectROI('identity annotations', image, fromCenter=False, showCrosshair=True)
+                if w and h: people.append(dict(identity=label, bbox=[int(x),int(y),int(x+w),int(y+h)]))
+            done[row['frame_id']] = dict(frame_id=row['frame_id'], target_identity='target', people=people)
+            args.out.parent.mkdir(parents=True, exist_ok=True)
+            args.out.write_text('\n'.join(json.dumps(done[k]) for k in sorted(done))+'\n')
+    finally:
+        cv2.destroyAllWindows()
+
+
+if __name__ == '__main__': main()
