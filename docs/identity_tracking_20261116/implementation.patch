+"""Persistent target identity, separate from native tracks and motor sessions.
+
+Evidence tiers are rule-based, not probabilities. All OSNet work runs in one
+bounded background job; only the AI owner consumes results and mutates identity.
+"""
+from concurrent.futures import Future
+from contextvars import copy_context
+import copy
+import math
+import threading
+import time
+from uuid import uuid4
+from ai.hybrid_reid import HybridReIDTargetSelector
+from ai.reid_target import iou
+from ai.reid.trusted_gallery import TrustedTargetGallery
+from runtime.identity_tracking import TargetObservation
+from telemetry import latency
+
+
+class IdentityAwareTargetSelector(HybridReIDTargetSelector):
+    retain_candidate_embeddings = True
+
+    def __init__(self, cfg, reid=None, clock=time.monotonic):
+        self.clock = clock
+        self._job = None
+        self._closed = False
+        self.metrics = dict(observed_frames=0, authorized_frames=0, uncertain_frames=0,
+            predicted_frames=0, reid_invocations=0, stale_results=0, recoveries=0,
+            recovery_attempts=0, abandoned_recoveries=0, short_recovery_failures=0,
+            occlusion_attempts=0, occlusion_recoveries=0, tracker_rebindings=0, recovery_latency_s=[],
+            reid_latency_ms=[], observed_target_seconds=0., ptz_commands_during_uncertain=None)
+        super().__init__(cfg, reid)
+
+    def reset(self, preserve_reacquire=False):
+        history = getattr(self, 'last_reliable_observation', None)
+        recovery = getattr(self, '_recovery_since', None)
+        occlusion = getattr(self, '_recovery_was_occlusion', False)
+        if recovery is not None and not preserve_reacquire:
+            self.metrics['abandoned_recoveries'] += 1
+        previous_uid = getattr(self, 'target_uid', None)
+        reference = getattr(self, 'embedding', None)
+        same_reference = reference is getattr(self, '_identity_reference', None)
+        super().reset(preserve_reacquire)
+        if same_reference and previous_uid is not None:
+            self.target_uid = previous_uid
+        self._identity_reference = reference
+        self.last_reliable_observation = history if preserve_reacquire else None
+        self._recovery_since = recovery if preserve_reacquire else None
+        self._recovery_was_occlusion = occlusion if preserve_reacquire else False
+        self._last_job_at = float('-inf')
+        self._last_result_frame = -1
+        self._last_observation_frame = -1
+        self._candidate_result_time = None
+        self._last_gallery_time = float('-inf')
+        self._last_diagnostic = float('-inf')
+        self._metric_time = None
+        self._previous_authorized = False
+        self._previous_status = None
+        self.observation = None
+        self._predictions = ()
+        self.last_raw_similarity = None
+        self._evidence_timestamp = self._evidence_frame_id = None
+        # Keep an in-flight slot occupied until it completes: resets cannot spawn
+        # unbounded GPU jobs. Its old epoch is rejected on consumption.
+
+    def _hold(self, reason, missing=False):
+        if missing and not self._recovery_was_occlusion:
+            self.metrics['occlusion_attempts'] += 1
+            self._recovery_was_occlusion = True
+        if not self.crossing_hold:
+            self._recovery_since = self.observation_time
+            self._last_job_at = float('-inf')
+            self.metrics['recovery_attempts'] += 1
+            super()._hold(reason, missing)
+        else:
+            self.transition_reason = reason
+            self.tracking_status = 'MISSING' if missing else 'TRACKED'
+            self.identity_status = 'UNCERTAIN'
+
+    def update_predictions(self, hypotheses):
+        # Hints are diagnostic only. They cannot become current observations or
+        # contribute to identity/gallery confirmation.
+        self._predictions = tuple(copy.deepcopy(hypotheses))
+
+    def _token(self):
+        return (self.target_uid, self.verification_epoch, self.lock_session_id, self.track_generation)
+
+    def close(self):
+        self._closed = True
+        self.verification_epoch = uuid4().hex
+        latency.profiler.event('IDENTITY_METRICS_FINAL', target_identity_id=self.target_uid,
+            metrics=copy.deepcopy(self.metrics), unresolved_recovery=self._recovery_since is not None)
+
+    def _prepare_gallery(self):
+        self._identity_reference = self.embedding
+        if self.gallery is None and self.embedding is not None:
+            self.gallery = TrustedTargetGallery(self.embedding[None, :],
+                max_size=self.cfg.IDENTITY_GALLERY_MAX_SIZE)
+            self.gallery.reference_floor = self.cfg.REID_KEEP_THRESHOLD
+        if self.gallery is not None and not isinstance(self.gallery, TrustedTargetGallery):
+            self.gallery = TrustedTargetGallery(self.gallery.embeddings,
+                max_size=self.cfg.IDENTITY_GALLERY_MAX_SIZE)
+            self.gallery.reference_floor = self.cfg.REID_KEEP_THRESHOLD
+
+    def _launch(self, frame, persons, now):
+        if self._job is not None or not persons:
+            return
+        scorer = copy.copy(self)
