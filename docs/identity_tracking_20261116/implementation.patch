+#!/usr/bin/env python3
+"""Summarize identity JSONL plus existing PTZ diagnostics; no camera connections."""
+import argparse
+from collections import Counter
+import json
+from pathlib import Path
+
+
+def summarize(paths):
+    rows = []
+    malformed = 0
+    for path in paths:
+        with Path(path).open() as stream:
+            for line in stream:
+                try: rows.append(json.loads(line))
+                except json.JSONDecodeError: malformed += 1
+    rows.sort(key=lambda r: r.get('timestamp_monotonic', r.get('monotonic_ns', 0)/1e9))
+    runs = {}
+    for row in rows:
+        run = runs.setdefault(row.get('run_id', 'unknown'), dict(
+            latest_metrics={}, statuses=Counter(), reasons=Counter(), stale_events=Counter(),
+            dispatches_with_uncertain_identity=0, dispatches_without_identity_context=0,
+            dispatches=0, last_decision=None, gmc_samples=0, gmc_applied=0))
+        event = row.get('event', '')
+        if event == 'IDENTITY_TRACKING_DECISION':
+            run['latest_metrics'] = row.get('metrics', {})
+            run['statuses'][row['status']] += 1
+            run['reasons'][row.get('reason')] += 1
+            run['last_decision'] = row
+            if row.get('camera_movement'):
+                run['gmc_samples'] += 1
+                run['gmc_applied'] += int(row['camera_movement'].get('applied', False))
+        elif event == 'IDENTITY_METRICS_FINAL':
+            run['latest_metrics'] = row.get('metrics', {})
+            run['unresolved_recovery'] = row.get('unresolved_recovery')
+        if 'DISCARD' in event or 'STALE' in event or 'MISMATCH' in str(row.get('reason', '')):
+            run['stale_events'][row.get('reason', event)] += 1
+        if event in ('PAN_TILT_DISPATCH', 'ZOOM_WORKER_DISPATCH'):
+            run['dispatches'] += 1
+            context = run['last_decision']
+            if context is None:
+                run['dispatches_without_identity_context'] += 1
+            elif not context['control_allowed']:
+                run['dispatches_with_uncertain_identity'] += 1
+    for run in runs.values(): run.pop('last_decision')
+    return dict(runs=runs, malformed_lines=malformed,
+        ground_truth_identity_switches=None,
+        note='Dispatch correlation uses latest logged identity state; includes bounded recovery zoom, not necessarily unsafe commands. Rotated or dropped logs limit coverage. Tracker rebindings are not ground-truth identity switches.')
+
+
+if __name__ == '__main__':
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('logs', nargs='+', type=Path)
+    p.add_argument('--out', type=Path)
+    args = p.parse_args()
+    payload = json.dumps(summarize(args.logs), indent=2)
+    if args.out: args.out.write_text(payload+'\n')
+    print(payload)
