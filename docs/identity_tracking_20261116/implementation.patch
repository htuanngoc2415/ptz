+#!/usr/bin/env python3
+"""Offline identity replay. Imports no camera transport and never creates controls.
+
+Cache actual YOLO/OSNet observations once, then compare both selectors on identical
+frames. Cached replay waits for each submitted ReID job before the next frame;
+this tests decisions, not asynchronous GPU contention or physical PTZ stability.
+"""
+import argparse
+import copy
+import json
+from pathlib import Path
+import sys
+import time
+from types import SimpleNamespace
+import cv2
+import numpy as np
+import torch
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import config
+from ai.hybrid_reid import HybridReIDTargetSelector
+from ai.identity_manager import IdentityAwareTargetSelector
+from ai.reid_target import iou
+from ai.reid.gallery import TargetEmbeddingGallery
+from ai.reid.trusted_gallery import TrustedTargetGallery
+from runtime.byte_tracking import ByteTrackPersonTracker
+from runtime.identity_tracking import IdentityPersonTracker
+
+
+def settings():
+    cfg = SimpleNamespace(**{k: getattr(config, k) for k in dir(config) if k.isupper()})
+    cfg.CAMERA_MOTION_DIAGNOSTICS_ENABLED = cfg.CAMERA_MOTION_RECORD_ENABLED = cfg.TRACK_SNAPSHOT_ENABLED = False
+    cfg.REID_DIAGNOSTICS = False
+    return cfg
+
+
+def cache_video(args):
+    from ai.detector import PersonDetector
+    from person_search.reid import OSNetReID
+    cfg = settings()
+    detector = PersonDetector(cfg.PERSON_MODEL_PATH, conf_threshold=cfg.BYTE_TRACK_LOW_THRESHOLD,
+        device=args.device)
+    model = OSNetReID(cfg.REID_MODEL_PATH, device='cpu' if args.device == 'cpu' else 'cuda:'+str(args.device),
+        batch_size=cfg.REID_BATCH_SIZE)
+    scorer = IdentityAwareTargetSelector(cfg, model)
+    target = scorer.load_target_from_path(args.reference, detector)
+    scorer.replace_target(target)
+    scorer._prepare_gallery()
+    cap = cv2.VideoCapture(str(args.video))
+    if not cap.isOpened(): raise ValueError('Cannot open video')
+    fps = cap.get(cv2.CAP_PROP_FPS)
+    stop = args.end if args.end is not None else cap.get(cv2.CAP_PROP_FRAME_COUNT)/fps
+    if not np.isfinite(fps) or fps <= 0 or stop <= args.start or args.sample_fps <= 0:
+        raise ValueError('Invalid video time range or FPS')
+    args.cache.mkdir(parents=True, exist_ok=True)
+    np.save(args.cache/'reference.npy', scorer.gallery.embeddings.cpu().numpy())
+    meta = dict(video=str(args.video.resolve()), source_kind=args.source_kind,
+        reference=str(Path(args.reference).resolve()), start=args.start, end=stop,
+        original_fps=fps, sample_fps=args.sample_fps, roi=args.roi,
+        sensor_timestamps_available=False, ground_truth_available=False)
+    (args.cache/'metadata.json').write_text(json.dumps(meta, indent=2))
+    stride = max(1, round(fps/args.sample_fps))
+    start_frame = round(args.start*fps)
+    cap.set(cv2.CAP_PROP_POS_FRAMES, start_frame)
+    fid = start_frame
+    count = 0
+    try:
+        with (args.cache/'frames.jsonl').open('w') as stream:
+            while fid/fps < stop:
+                ok, frame = cap.read()
+                if not ok: break
+                if (fid-start_frame) % stride:
+                    fid += 1
+                    continue
+                if args.roi:
+                    x, y, w, h = args.roi
+                    if min(x,y) < 0 or min(w,h) <= 0 or x+w > frame.shape[1] or y+h > frame.shape[0]:
+                        raise ValueError('ROI outside video frame')
+                    frame = frame[y:y+h, x:x+w]
+                begin = time.perf_counter()
+                persons = detector.detect(frame)
+                if detector.last_error: raise RuntimeError(detector.last_error)
+                detection_ms = (time.perf_counter()-begin)*1000
+                begin = time.perf_counter()
+                if persons: scorer._scores(frame, persons)
+                reid_ms = (time.perf_counter()-begin)*1000
+                rows = []
+                for p in persons:
+                    rows.append(dict(bbox=p['bbox'], confidence=float(p['confidence']),
+                        embedding=p['_identity_embedding'].tolist(), raw_similarity=p['raw_similarity'],
+                        normalized_similarity=p.get('normalized_similarity'), reid_score=p['reid_score']))
+                name = f'frame_{fid:08d}.jpg'
+                if not cv2.imwrite(str(args.cache/name), frame): raise OSError('Cannot save replay frame')
+                stream.write(json.dumps(dict(frame_id=fid, timestamp=fid/fps, image=name,
+                    detections=rows, detection_ms=detection_ms, reid_ms=reid_ms))+'\n')
+                count += 1
+                if count % 50 == 0: print(f'Cached {count} observations at video {fid/fps:.1f}s', flush=True)
+                fid += 1
+    finally:
+        cap.release()
+    return count
+
+
+def evaluate(decisions, records, annotations=None):
+    allowed = [d['control_allowed'] for d in decisions]
+    elapsed = [max(0., records[i+1]['timestamp']-r['timestamp']) if i+1 < len(records) else 0.
+               for i, r in enumerate(records)]
+    losses = sum(a and not b for a, b in zip(allowed, allowed[1:]))
+    recoveries, durations = 0, []
+    lost_at = None
+    ever = False
+    for d, row in zip(decisions, records):
+        if d['control_allowed']:
+            if lost_at is not None:
+                recoveries += 1
+                durations.append(row['timestamp']-lost_at)
+                lost_at = None
+            ever = True
+        elif ever and lost_at is None:
+            lost_at = row['timestamp']
+    result = dict(selected_observation_seconds=sum(dt for dt, ok in zip(elapsed, allowed) if ok),
+        loss_count=losses, recovery_count=recoveries, recovery_durations_s=durations,
+        unresolved_recovery=lost_at is not None, correct_target_observation_seconds=None,
+        identity_switches=None, false_reacquisitions=None, annotated_frames=0,
+        ptz_stability=None, note='Selected dwell is not proof of correct identity. Predictions excluded.')
+    if annotations is None: return result
+    truth = {a['frame_id']: a for a in annotations if a.get('people') is not None}
+    if not truth: return result
+    correct = 0.
+    switches = false_reacquisitions = 0
+    previous_identity = None
+    for d, row, dt in zip(decisions, records, elapsed):
+        gt = truth.get(row['frame_id'])
+        if gt is None: continue
+        result['annotated_frames'] += 1
+        if not d['control_allowed']: continue
+        ranked = sorted(((iou(d['bbox'], p['bbox']), p['identity']) for p in gt['people']), reverse=True)
+        ident = ranked[0][1] if ranked and ranked[0][0] >= .5 else None
+        if ident == gt['target_identity']: correct += dt
+        if ident is not None and previous_identity is not None and ident != previous_identity: switches += 1
+        if d.get('just_locked') and ident != gt['target_identity']: false_reacquisitions += int(d.get('recovery', False))
+        if ident is not None: previous_identity = ident
+    result.update(correct_target_observation_seconds=correct, identity_switches=switches,
+                  false_reacquisitions=false_reacquisitions,
+                  annotation_coverage=len(truth)/max(1,len(records)),
+                  note='Identity metrics apply only to annotated observations; use dense labels for acceptance.')
+    return result
+
+
+def replay(records, frame_loader, reference, annotations=None):
+    branches = {}
+    for name, tracker_type, selector_type in [('legacy', ByteTrackPersonTracker, HybridReIDTargetSelector),
+                                               ('identity', IdentityPersonTracker, IdentityAwareTargetSelector)]:
+        cfg = settings()
+        tracker = tracker_type(cfg)
+        clock = [0.]
+        selector = selector_type(cfg, clock=lambda: clock[0]) if name == 'identity' else selector_type(cfg)
+        selector.embedding = reference[0]
+        selector.gallery = TargetEmbeddingGallery(reference)
+        selector.error = None
+        decisions, timings = [], []
+        calls = [0]
+        def scores(frame, persons):
+            calls[0] += 1
+            result = []
+            for p in persons:
+                if 'embedding' in p:
+                    embedding = torch.tensor(p['embedding'], dtype=torch.float32)
+                    p['_identity_embedding'] = embedding
+                    p['reference_similarity'] = float((embedding @ reference.T).max())
+                    value = float(selector.gallery.score(embedding[None])[0])
+                    if p.get('normalized_similarity') is not None:
+                        value = max(value, p['normalized_similarity'])
+                else:
+                    value = p['reid_score']
+                result.append(value)
+            return result
+        selector._scores = scores
+        for row in records:
+            frame = frame_loader(row)
+            clock[0] = row['timestamp']
+            selector.frame_id = row['frame_id']
+            begin = time.perf_counter()
+            persons = tracker.update(copy.deepcopy(row['detections']), row['timestamp'],
+                                      frame=frame, frame_id=row['frame_id'])
+            if name == 'identity': selector.update_predictions(tracker.hypotheses(row['timestamp']))
+            person = selector.select_person(frame, persons, row['timestamp'])
+            job = getattr(selector, '_job', None) if name == 'identity' else getattr(selector, '_verification', None)
+            if job: job[0].result(timeout=10)
+            decisions.append(dict(frame_id=row['frame_id'], timestamp=row['timestamp'],
+                bbox=list(person['bbox']) if person else None, track_id=selector.track_id if person else None,
+                target_identity_id=selector.target_uid, control_allowed=person is not None,
+                state=selector.stage, just_locked=selector.just_locked,
+                recovery=getattr(selector, 'transition_reason', '') == 'TARGET_REACQUIRED',
+                reason=getattr(selector, 'transition_reason', None), similarity=selector.top1,
+                observed_track_ids=[p['track_id'] for p in persons],
+                predicted_count=len(tracker.hypotheses(row['timestamp'])) if name == 'identity' else None))
+            lost = selector.finish_frame(person, None)
+            if lost and name == 'legacy': tracker.reset()
+            timings.append((time.perf_counter()-begin)*1000)
+        branches[name] = dict(metrics=evaluate(decisions, records, annotations),
+            reid_invocations=calls[0], association_selection_mean_ms=float(np.mean(timings)),
+            association_selection_p95_ms=float(np.percentile(timings, 95)), decisions=decisions)
+    return dict(branches=branches, physical_ptz_commands=0,
+        timing_scope='Cached evidence association/selection and optional image GMC; excludes YOLO/OSNet and real async contention',
+        production_acceptance=False)
+
+
+def synthetic():
+    records, truth = [], []
+    for i in range(100):
+        x = 100+i
+        visible = not 75 <= i < 80
+        detections = [dict(bbox=[x,50,x+70,250], confidence=.95,
+            reid_score=.4 if 20 <= i < 60 else .95)] if visible else []
+        records.append(dict(frame_id=i, timestamp=i/10, detections=detections))
+        truth.append(dict(frame_id=i, target_identity='target', people=[dict(identity='target',bbox=d['bbox']) for d in detections]))
+    result = replay(records, lambda row: np.zeros((400,600,3),np.uint8), torch.eye(512)[:1], truth)
+    result['provenance'] = 'Synthetic walking, appearance dip, temporary disappearance; scripted cosine evidence, not model accuracy'
+    return result
+
+
+def load_cache(directory):
+    records = [json.loads(line) for line in (directory/'frames.jsonl').read_text().splitlines()]
+    if not records: raise ValueError('Empty cache')
+    for a, b in zip(records, records[1:]):
+        if b['frame_id'] <= a['frame_id'] or b['timestamp'] <= a['timestamp']:
+            raise ValueError('Replay requires increasing frame IDs and timestamps')
+    def loader(row):
+        path = (directory/row['image']).resolve()
+        if directory.resolve() not in path.parents: raise ValueError('Image must be inside cache')
+        image = cv2.imread(str(path))
+        if image is None: raise ValueError('Missing replay image')
+        return image
+    return records, loader, torch.from_numpy(np.load(directory/'reference.npy', allow_pickle=False))
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--video', type=Path)
+    p.add_argument('--cache', type=Path)
+    p.add_argument('--reference', default=config.TARGET_IMAGE_PATH)
+    p.add_argument('--device', default='cpu')
+    p.add_argument('--start', type=float, default=0.)
+    p.add_argument('--end', type=float)
+    p.add_argument('--sample-fps', type=float, default=10.)
+    p.add_argument('--roi', nargs=4, type=int, metavar=('X','Y','W','H'))
+    p.add_argument('--source-kind', choices=['raw_camera','monitor_recording','unknown'], default='unknown')
+    p.add_argument('--synthetic', action='store_true')
+    p.add_argument('--annotations', type=Path)
+    p.add_argument('--annotation-template', type=Path)
+    p.add_argument('--out', type=Path, required=True)
+    args = p.parse_args()
+    cv2.setNumThreads(1)
+    torch.set_num_threads(1)
+    if args.synthetic:
+        result = synthetic()
+    else:
+        if not args.cache: p.error('--cache is required')
+        if args.video: cache_video(args)
+        rows, loader, reference = load_cache(args.cache)
+        if args.annotation_template:
+            args.annotation_template.write_text('\n'.join(json.dumps(dict(frame_id=r['frame_id'],
+                timestamp=r['timestamp'], image=r['image'], target_identity='target', people=None)) for r in rows)+'\n')
+        annotations = [json.loads(s) for s in args.annotations.read_text().splitlines()] if args.annotations else None
+        result = replay(rows, loader, reference, annotations)
+        result['provenance'] = json.loads((args.cache/'metadata.json').read_text())
+        result['model_cache_timings'] = {key: dict(mean_ms=float(np.mean([r[key] for r in rows])),
+            p95_ms=float(np.percentile([r[key] for r in rows],95))) for key in ('detection_ms','reid_ms') if key in rows[0]}
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    for name, branch in result['branches'].items():
+        path = args.out.with_name(args.out.stem+'_'+name+'_decisions.jsonl')
+        path.write_text('\n'.join(json.dumps(d) for d in branch.pop('decisions'))+'\n')
+        branch['decisions_path'] = str(path)
+    args.out.write_text(json.dumps(result, indent=2))
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == '__main__': main()
