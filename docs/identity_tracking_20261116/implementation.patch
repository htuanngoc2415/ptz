+"""BoT-SORT adapter. Only detector observations can authorize target control."""
+from dataclasses import dataclass, asdict
+import numpy as np
+from ultralytics.trackers.bot_sort import BOTSORT, BOTrack
+from .byte_tracking import ByteTrackPersonTracker
+from .camera_motion import CameraMotionEstimator, MotionEstimate
+from ai.reid_target import iou
+from telemetry import latency
+
+
+@dataclass(frozen=True)
+class TargetObservation:
+    bbox: tuple | None
+    observation_timestamp: float
+    frame_id: int
+    target_identity_id: str
+    track_id: int | None
+    tracking_confidence: float
+    identity_confidence: str  # evidence tier, not a calibrated probability
+    status: str
+    session_generation: int
+    camera_movement: dict | None
+    control_allowed: bool
+    zoom_allowed: bool = False
+
+    def payload(self):
+        return asdict(self)
+
+
+def admitted_warp(estimate, minimum_quality):
+    if not estimate.valid or not np.isfinite(estimate.confidence) or estimate.confidence < minimum_quality:
+        return None
+    H = np.asarray(estimate.transform, dtype=float)
+    if H.shape != (2, 3) or not np.isfinite(H).all():
+        return None
+    # XYWH is axis aligned. Do not rotate width/height with a generic R-kron warp.
+    if abs(H[0, 1]) > .01 or abs(H[1, 0]) > .01 or not .85 <= H[0, 0] <= 1.18 or not .85 <= H[1, 1] <= 1.18:
+        return None
+    return H
+
+
+class EvidenceBoTSORT(BOTSORT):
+    def __init__(self, args, frame_rate):
+        super().__init__(args, frame_rate)
+        self.warp = None
+        self.predictions = {}
+
+    def init_track(self, results, img=None):
+        return [BOTrack(np.r_[box, row[5]], score, 0)
+                for box, row, score in zip(results.xywh, results.rows, results.conf)]
+
+    def multi_predict(self, tracks):
+        super().multi_predict(tracks)
+        pending = list(tracks) + [t for t in self.tracked_stracks if not t.is_activated]
+        seen = set()
+        self.predictions = {}
+        for track in pending:
+            if id(track) in seen or track.mean is None:
+                continue
+            seen.add(id(track))
+            if self.warp is not None:
+                H = self.warp
+                J = np.diag([H[0, 0], H[1, 1]] * 4)
+                track.mean = J @ track.mean
+                track.mean[:2] += H[:, 2]
+                track.covariance = J @ track.covariance @ J.T
+                track.covariance[:2, :2] += np.eye(2)
+            self.predictions[track.track_id] = tuple(float(v) for v in track.xyxy)
+
+
+class IdentityPersonTracker(ByteTrackPersonTracker):
+    """Maintained Kalman/lost buffering plus time, ambiguity, and GMC evidence.
+
+    Appearance is consumed by the identity manager, never substituted for a
+    native ID. This adapter does not load Ultralytics' separate ReID encoder.
+    """
+    def __init__(self, cfg):
+        super().__init__(cfg)
+        args = self.tracker.args
+        args.gmc_method = 'none'
+        args.with_reid = False
+        args.proximity_thresh = .5
+        args.appearance_thresh = .8
+        self.tracker = EvidenceBoTSORT(args, cfg.AI_MAX_FPS)
+        self.estimator = CameraMotionEstimator(cfg.CAMERA_MOTION_DOWNSCALE)
+        self.previous = None
+        self.history = {}
+        self.motion = MotionEstimate(reason='FIRST_FRAME')
+        self.last_frame_id = None
+
+    def reset(self):
+        super().reset()
+        self.previous = None
+        self.history = {}
+        self.last_frame_id = None
+        self.motion = MotionEstimate(reason='RESET')
+
+    @latency.measured('IDENTITY_TRACK_ASSOCIATION', 'identity_track_association_ms')
+    def update(self, persons, received, frame=None, frame_id=None):
+        if not np.isfinite(received) or (self.last_received is not None and received <= self.last_received) or (
+                frame_id is not None and self.last_frame_id is not None and frame_id <= self.last_frame_id):
+            latency.profiler.count('identity_tracker_stale_frames')
+            return []
+        if self.last_received is not None and received-self.last_received > self.cfg.REID_LOST_GRACE_SEC:
+            self.reset()
+        persons = list({id(p): p for p in persons}.values())
+        boxes = [p['bbox'] for p in persons]
+        self.motion = MotionEstimate(reason='NO_FRAME_PAIR')
+        if frame is not None and self.previous is not None and self.cfg.IDENTITY_GMC_ENABLED:
+            old, stamp, old_boxes = self.previous
+            self.motion = self.estimator.estimate(old, frame, stamp, received, old_boxes, boxes,
+                                                   self.cfg.CAMERA_MOTION_OSD_BOXES)
+        self.previous = (frame.copy(), received, boxes) if frame is not None else None
+        self.tracker.warp = admitted_warp(self.motion, self.cfg.IDENTITY_GMC_MIN_QUALITY)
+        self.last_frame_id = frame_id
+        # Native tracker sees no image, so its own GMC cannot apply a second warp.
+        output = super().update(persons, received, frame=None, frame_id=frame_id)
+        active = {t.track_id: t for t in self.tracker.tracked_stracks}
+        reverse = {v: k for k, v in self.ids.items()}
+        for person in output:
+            tid = person['track_id']
+            native = reverse[tid]
+            predicted = self.tracker.predictions.get(native)
+            association = iou(predicted, person['bbox']) if predicted else 0.
+            competitors = [iou(predicted, p['bbox']) for p in persons
+                           if p is not persons[person['tracker_source_index']]] if predicted else []
+            competitors.extend(iou(box, person['bbox']) for other, box in self.tracker.predictions.items()
+                               if other != native)
+            margin = association-max(competitors, default=0.)
+            old = self.history.get(tid)
+            gap = received-old['last_observed_timestamp'] if old else None
+            track = active[native]
+            visible = 1.
+            if frame is not None:
+                h, w = frame.shape[:2]
+                x1, y1, x2, y2 = person['bbox']
+                area = max(1., (x2-x1)*(y2-y1))
+                visible = max(0, min(w, x2)-max(0, x1))*max(0, min(h, y2)-max(0, y1))/area
+                # Border-touching crops may already have been clipped by YOLO.
+                if x1 <= 1 or y1 <= 1 or x2 >= w-1 or y2 >= h-1:
+                    visible = min(visible, .5)
+            person.update(last_observed_frame_id=frame_id, last_observed_timestamp=received,
+                predicted_bbox=predicted, velocity_estimate=track.mean[4:6].tolist(),
+                track_age=self.tracker.frame_id-track.start_frame+1, time_since_update=0.,
+                observation_gap=gap, association_confidence=association, association_margin=margin,
+                visibility=visible, tracking_status='OBSERVED',
+                camera_movement=dict(self.motion.payload(), applied=self.tracker.warp is not None),
+                temporal_reliable=bool(old is not None and gap <= self.cfg.IDENTITY_MAX_OBSERVATION_GAP
+                    and association >= self.cfg.IDENTITY_ASSOC_IOU and margin >= self.cfg.REID_ASSOC_MARGIN))
+            self.history[tid] = dict(person)
+        # Native BoT-SORT suppresses tentative/weak unmatched tracks. Keep those
+        # detections visible to identity/face ambiguity gates; provisional IDs
+        # cannot accumulate identity confirmations across frames.
+        emitted = {p['tracker_source_index'] for p in output}
+        for index, detection in enumerate(persons):
+            if index not in emitted:
+                output.append(dict(detection, track_id=-(self.tracker.frame_id*100000+index+1),
+                    tracker_source_index=index, last_observed_frame_id=frame_id,
+                    last_observed_timestamp=received, temporal_reliable=False,
+                    tracking_status='TENTATIVE', association_confidence=0.,
+                    association_margin=0., visibility=0., track_age=1,
+                    camera_movement=dict(self.motion.payload(), applied=self.tracker.warp is not None)))
+        self.history = {k: v for k, v in self.history.items()
+                        if received-v['last_observed_timestamp'] <= self.cfg.REID_LOST_GRACE_SEC}
+        return output
+
+    def hypotheses(self, now):
+        """Diagnostics/recovery hints only; never returned by update as observations."""
+        rows = []
+        for tid, item in self.history.items():
+            age = now-item['last_observed_timestamp']
+            if not 0 < age <= self.cfg.IDENTITY_PREDICTION_MAX_AGE:
+                continue
+            box = np.array(item['bbox'], dtype=float)
+            velocity = np.array(item['velocity_estimate']) * self.cfg.AI_MAX_FPS * age
+            box += np.tile(velocity, 2)
+            rows.append(dict(track_id=tid, bbox=box.tolist(), time_since_update=age,
+                             tracking_status='PREDICTED', control_allowed=False))
+        return rows
