+"""Copy-on-write target gallery; the original references are immutable anchors."""
+import torch
+from .gallery import TargetEmbeddingGallery
+
+
+class TrustedTargetGallery(TargetEmbeddingGallery):
+    def __init__(self, embeddings, reference_count=None, provenance=None, max_size=12):
+        super().__init__(embeddings.clone())
+        self.reference_count = len(embeddings) if reference_count is None else reference_count
+        self.max_size = max(self.reference_count, max_size)
+        self.provenance = tuple(provenance or [dict(source='reference', index=i)
+                                              for i in range(self.reference_count)])
+
+    def reference_score(self, embeddings):
+        return (embeddings @ self.embeddings[:self.reference_count].T).max(dim=1).values
+
+    def score(self, embeddings):
+        reference = self.reference_score(embeddings)
+        live = self.embeddings[self.reference_count:]
+        if len(live) < 2:
+            return reference
+        # Two independent admitted views must agree. One lucky live match cannot
+        # authorize recovery; a minimum reference anchor is required as well.
+        support = (embeddings @ live.T).topk(2, dim=1).values[:, 1]
+        return torch.where(reference >= self.reference_floor,
+                           torch.maximum(reference, support), reference)
+
+    reference_floor = .5
+
+    def admit(self, embedding, provenance, *, reference_threshold, duplicate=.98):
+        embedding = embedding.detach().to(self.embeddings).reshape(1, -1)
+        # Validate dimensions, finite values and normalization through the base API.
+        TargetEmbeddingGallery(embedding)
+        if self.reference_score(embedding).item() < reference_threshold:
+            return self
+        if (embedding @ self.embeddings.T).max().item() >= duplicate:
+            return self
+        if self.max_size <= self.reference_count:
+            return self
+        live = self.embeddings[self.reference_count:]
+        metadata = list(self.provenance[self.reference_count:])
+        if len(live) >= self.max_size-self.reference_count:
+            live, metadata = live[1:], metadata[1:]
+        result = TrustedTargetGallery(torch.cat([self.embeddings[:self.reference_count], live, embedding]),
+            self.reference_count, list(self.provenance[:self.reference_count])+metadata+[dict(provenance)], self.max_size)
+        result.reference_floor = self.reference_floor
+        return result
+
+    def rollback(self, since_frame_id):
+        keep = list(range(self.reference_count)) + [i for i in range(self.reference_count, len(self.embeddings))
+                if self.provenance[i]['frame_id'] < since_frame_id]
+        result = TrustedTargetGallery(self.embeddings[keep], self.reference_count,
+            [self.provenance[i] for i in keep], self.max_size)
+        result.reference_floor = self.reference_floor
+        return result
