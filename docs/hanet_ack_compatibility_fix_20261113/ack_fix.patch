+        self.assertEqual(schema['result_type'], 'dict')
+        self.assertEqual(schema['response_shape']['fields']['result']['fields']['status']['type'], 'str')
+
+    def test_diagnostics_bounded_for_large_and_deep_response(self):
+        nested = {'status':True}
