+        second=fixtures.FakeSocket()
+        with patch('camera.hanet_rpc.socket.create_connection',return_value=second):
+            self.client._next_reconnect=0
+            self.assertTrue(self.camera.emergency_stop()[0]);zoom.stop()
+            self.assertIsNone(self.owner.owner)
+            self.assertTrue(self.submit());self.assertTrue(self.ended.wait(2))
+        self.assertEqual([r['params']['data']['operate'] for r in second.commands],
+                         ['kOperateStop','kOperateStart','kOperateStop'])
+        self.assertFalse(zoom.busy)
+
