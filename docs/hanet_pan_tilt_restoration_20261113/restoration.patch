+"""Offline checkpoint durability and full pan transport path, no firmware claims."""
+import json
+import os
+from pathlib import Path
+import stat
+import sys
+import tempfile
+import threading
+import time
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock, patch
+from contextlib import ExitStack
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import config
+from camera.hanet_controller import HanetController
+from camera.hanet_rpc import HanetPTZClient
+from control.auto_pan_tilt import AutoPanTiltController
+from control.auto_zoom import AutoZoomController
+from control.orchestrator import ControlOrchestrator
+from telemetry import latency
+from camera.hanet_ack import validate_response, ACK_UNKNOWN, PROTOCOL_ERROR
+import test_hanet_fault_injection as fixtures
+
+
+class RecordedSchemaTests(unittest.TestCase):
+    def test_observed_stop_shape_is_not_firmware_success_fixture(self):
+        fixture=json.loads((Path(__file__).parent/'fixtures/hanet_stop_empty_result_20261113.json').read_text())
+        decision=validate_response(fixture['response'],fixture['request_id'],
+            operation=fixture['provenance']['operation'],code=fixture['provenance']['code'])
+        self.assertEqual((decision.classification,decision.reason),(ACK_UNKNOWN,'EMPTY_RESULT_UNVERIFIED'))
+        self.assertFalse(fixture['provenance']['raw_response_captured'])
+
+    def test_scope_is_control_do_ptz_and_unknown_not_promoted_for_any_direction(self):
+        self.assertEqual(validate_response({'id':'r','result':True},'r',method='Other.Method').classification,ACK_UNKNOWN)
+        for op in ('START','STOP'):
+            for code in HanetController.CODES.values():
+                with self.subTest(operation=op,code=code):
+                    self.assertEqual(validate_response({'id':'r','result':{}},'r',operation=op,code=code).classification,ACK_UNKNOWN)
+        self.assertEqual(validate_response({'id':'r','result':True},'r',operation='MOVE').classification,PROTOCOL_ERROR)
+        self.assertEqual(validate_response({'id':'r','result':True},'r',code='other').classification,PROTOCOL_ERROR)
+
+
+class PersistedRecoveryTests(unittest.TestCase):
+    def setUp(self):
+        self.stack = ExitStack(); self.addCleanup(self.stack.close)
+        self.directory = Path(self.stack.enter_context(tempfile.TemporaryDirectory()))
+        self.path = self.directory/'motor.json'
+        self.stack.enter_context(patch('socket.create_connection', side_effect=AssertionError('NO REAL SOCKET')))
+        self.stack.enter_context(patch('requests.sessions.Session.request', side_effect=AssertionError('NO REAL HTTP')))
+
+    def camera(self, rpc=None):
+        if rpc is None:
+            rpc=Mock(); rpc.motion.return_value=True
+        camera=HanetController(ip='offline.invalid',username='u',password='p',timeout=.1,
+            autoconnect=False,rpc_factory=lambda *a,**k:rpc,safety_state_path=self.path)
+        self.addCleanup(camera.close)
+        return camera,rpc
+
+    def test_clean_startup_and_version_one_empty_checkpoint(self):
+        camera,rpc=self.camera()
+        self.assertEqual(camera.motor_state,'READY');rpc.motion.assert_not_called()
+        camera.close()
+        self.path.write_text(json.dumps({'version':1,'active_codes':[]}))
+        camera,rpc=self.camera()
+        self.assertEqual(camera.motor_state,'READY');rpc.motion.assert_not_called()
+
+    def test_unknown_checkpoint_version_must_not_grant_ready(self):
+        self.path.write_text(json.dumps({'version':999,'active_codes':[]}))
+        camera,rpc=self.camera()
+        self.assertTrue(camera._motor_fault)
+        self.assertFalse(camera.command('pan_left')[0]);rpc.motion.assert_not_called()
+
+    def test_incomplete_or_corrupt_checkpoint_blocks_start(self):
+        for text in ('{', '{}', '{"active_codes":[]}', '{"version":true,"active_codes":[]}',
+                     '{"version":1,"active_codes":["foreign"]}'):
+            with self.subTest(text=text):
+                self.path.write_text(text)
+                camera,rpc=self.camera()
+                self.assertTrue(camera._motor_fault)
+                self.assertFalse(camera.command('zoom_in')[0]);rpc.motion.assert_not_called()
+                camera.close()
+
+    def test_loaded_fault_has_no_start_replay_and_explicit_recovery_updates_disk(self):
+        self.path.write_text(json.dumps({'version':1,'active_codes':['kCmdZoomWide']}))
+        camera,rpc=self.camera()
+        self.assertEqual(camera.motor_state,'FAULT_LATCHED')
+        self.assertFalse(camera.command('pan_left')[0]);rpc.motion.assert_not_called()
+        self.assertTrue(camera.emergency_stop()[0])
+        self.assertEqual(rpc.motion.call_args.args,('kCmdZoomWide',False,1))
+        self.assertEqual(json.loads(self.path.read_text())['active_codes'],[])
+        camera.close()
+        restarted,new_rpc=self.camera()
+        self.assertEqual(restarted.motor_state,'READY');new_rpc.motion.assert_not_called()
+
+    def test_unknown_stop_keeps_checkpoint(self):
+        from camera.hanet_ack import HanetACKUnknown
+        self.path.write_text(json.dumps({'version':1,'active_codes':['kCmdZoomWide']}))
+        camera,rpc=self.camera();rpc.motion.side_effect=HanetACKUnknown('unknown')
+        self.assertFalse(camera.emergency_stop()[0])
+        self.assertTrue(camera._motor_fault)
+        self.assertEqual(json.loads(self.path.read_text())['active_codes'],['kCmdZoomWide'])
+
+    def test_crash_after_stop_ack_before_checkpoint_write_keeps_old_fault(self):
+        camera,rpc=self.camera();camera.command('pan_left')
+        # Preserve the on-disk snapshot as if the process died before persistence.
+        old=self.path.read_bytes()
+        with patch.object(camera,'_save_motor_state',side_effect=OSError('disk')):
+            self.assertFalse(camera.stop()[0])
+        self.assertEqual(self.path.read_bytes(),old)
+        restarted,_=self.camera()
+        self.assertTrue(restarted._motor_fault)
+
+    def test_directory_fsync_failure_after_empty_replace_keeps_restart_fault(self):
+        camera,rpc=self.camera();camera.command('pan_left')
+        real=os.fsync
+        def fail_after_clear(fd):
+            if stat.S_ISDIR(os.fstat(fd).st_mode) and not json.loads(self.path.read_text())['active_codes']:
+                raise OSError('simulated directory fsync failure')
+            return real(fd)
+        with patch('camera.hanet_controller.os.fsync',side_effect=fail_after_clear):
+            self.assertFalse(camera.stop()[0])
+        self.assertTrue(camera._motor_fault)
+        restarted,_=self.camera()
+        self.assertTrue(restarted._motor_fault)
+        self.assertIn('kCmdLeft',restarted._active_codes)
+
+    def test_checkpoint_write_failure_is_not_reported_as_no_wire_ack(self):
+        camera,rpc=self.camera();camera.command('pan_left')
+        with (patch.object(camera,'_save_motor_state',side_effect=OSError('disk')),
+              patch.object(latency.profiler,'event',wraps=latency.profiler.event) as events):
+            self.assertFalse(camera.stop()[0])
+        self.assertTrue(any(c.args[0]=='MOTOR_CHECKPOINT_COMMIT_FAILED'
+                            and c.kwargs.get('rpc_stop_accepted') is True for c in events.call_args_list))
+
+    def test_durable_guard_survives_crash_before_cleanup(self):
+        camera,rpc=self.camera();camera.command('pan_left')
+        with patch.object(camera,'_discard_stop_guard'):
+            self.assertTrue(camera.stop()[0])
+        self.assertEqual(json.loads(self.path.read_text())['active_codes'],[])
+        restarted,_=self.camera()
+        self.assertTrue(restarted._motor_fault)
+        self.assertEqual(restarted._active_codes,{'kCmdLeft'})
+        self.assertTrue(restarted.emergency_stop()[0])
+        self.assertFalse(restarted._stop_guard_path.exists())
+
+    def test_corrupt_pending_guard_never_grants_ready(self):
+        self.path.write_text(json.dumps({'version':1,'active_codes':[]}))
+        self.path.with_suffix('.pending').write_text('{broken')
+        camera,rpc=self.camera()
+        self.assertTrue(camera._motor_fault)
+        self.assertFalse(camera.command('pan_left')[0]);rpc.motion.assert_not_called()
+
+    def test_guard_cleanup_failure_retains_restart_uncertainty(self):
+        camera,rpc=self.camera();camera.command('zoom_out')
+        real=Path.unlink
+        def fail_guard(path,*a,**kw):
+            if path==camera._stop_guard_path:raise OSError('cleanup failed')
+            return real(path,*a,**kw)
+        with patch.object(Path,'unlink',fail_guard):
+            self.assertTrue(camera.stop()[0])  # main STOP checkpoint is already durable
+        restarted,_=self.camera()
+        self.assertTrue(restarted._motor_fault)
+
+    def test_write_failure_before_start_never_transmits_start(self):
+        camera,rpc=self.camera()
+        with patch.object(camera,'_save_motor_state',side_effect=OSError('disk')):
+            self.assertFalse(camera.command('pan_left')[0])
+        self.assertFalse(any(call.args[1] for call in rpc.motion.call_args_list))
+
+    def test_partial_multi_direction_stop_keeps_unconfirmed_direction(self):
+        from camera.hanet_ack import HanetACKUnknown
+        self.path.write_text(json.dumps({'version':1,'active_codes':['kCmdLeft','kCmdZoomWide']}))
+        camera,rpc=self.camera()
+        def motion(code,start,speed):
+            if code=='kCmdZoomWide':raise HanetACKUnknown('unknown')
+            return True
+        rpc.motion.side_effect=motion
+        self.assertFalse(camera.emergency_stop()[0])
+        self.assertEqual(camera._active_codes,{'kCmdZoomWide'})
+        self.assertEqual(json.loads(self.path.read_text())['active_codes'],['kCmdZoomWide'])
+
