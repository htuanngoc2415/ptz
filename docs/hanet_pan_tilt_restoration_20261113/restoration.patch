+class PanTransportRecoveryTests(unittest.TestCase):
+    def setUp(self):
+        self.stack=ExitStack();self.addCleanup(self.stack.close)
+        self.directory=Path(self.stack.enter_context(tempfile.TemporaryDirectory()))
+        self.stack.enter_context(patch('requests.sessions.Session.request',side_effect=AssertionError('NO REAL HTTP')))
+        self.wire=fixtures.FakeSocket()
+        self.stack.enter_context(patch('camera.hanet_rpc.socket.create_connection',return_value=self.wire))
+        def login(client):client.session_id='synthetic-session'
+        self.stack.enter_context(patch.object(HanetPTZClient,'_login',login))
+        self.client=HanetPTZClient('offline.invalid',80,'u','p',timeout=.1)
+        self.camera=HanetController(ip='offline.invalid',username='u',password='p',timeout=.1,
+            autoconnect=False,rpc_factory=lambda *a,**k:self.client,safety_state_path=self.directory/'state.json')
+        self.addCleanup(self.camera.close)
+        self.owner=ControlOrchestrator()
+        self.cfg=SimpleNamespace(**{k:getattr(config,k) for k in dir(config) if k.isupper()})
+        self.cfg.AUTO_PAN_TILT_ENABLED=True
+        self.pan=AutoPanTiltController(self.camera,self.owner,self.cfg)
+        self.pan.session_valid=lambda session,track:session=='current' and track==1
+        self.addCleanup(self.pan.close)
+        self.events=[];self.ended=threading.Event();self.blocked=threading.Event()
+        def event(name,**fields):
+            self.events.append((name,fields))
+            if name=='PAN_TILT_COMMAND_ENDED':self.ended.set()
+            if name=='PAN_TILT_DECISION' and fields.get('decision_reason')=='MOTOR_BUSY':self.blocked.set()
+        self.stack.enter_context(patch.object(latency.profiler,'event',side_effect=event))
+
+    def submit(self,box=(700,200,900,400),age=0,session='current'):
+        return self.pan.submit({'bbox':box},(600,1000,3),time.monotonic()-age,session,1)
+
+    def test_full_path_valid_off_center_target_dispatches_start_stop(self):
+        self.assertTrue(self.submit());self.assertTrue(self.ended.wait(2))
+        operations=[r['params']['data']['operate'] for r in self.wire.commands]
+        self.assertEqual(operations,['kOperateStart','kOperateStop'])
+        names=[n for n,f in self.events]
+        for name in ('PAN_TILT_DISPATCH','PAN_TILT_START_ACK','PAN_TILT_STOP_ACK'):
+            self.assertIn(name,names)
+        self.assertEqual(self.camera.motor_state,'READY');self.assertIsNone(self.owner.owner)
+
+    def test_deadzone_uncertain_and_stale_do_not_dispatch(self):
+        for kwargs,reason in (({'box':(450,250,550,350)},'DEADZONE'),
+                              ({'session':'other'},'TARGET_UNCERTAIN'),
+                              ({'age':10},'STALE_OBSERVATION')):
+            with self.subTest(reason=reason):
+                self.assertFalse(self.submit(**kwargs))
+                self.assertEqual(self.events[-1][1]['decision_reason'],reason)
+        self.assertFalse(self.wire.commands)
+
+    def test_zoom_owner_blocks_pan_until_confirmed_recovery_then_real_dispatch(self):
+        self.owner.acquire('zoom')
+        # Active/fault state created through the real backend; synthetic response contract only.
+        self.assertTrue(self.camera.command('zoom_out')[0])
